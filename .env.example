# Database (docker compose)
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro
POSTGRES_DB=agrocopilot
DB_PORT=5433

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend running outside Docker (local development)
DATABASE_URL=postgresql+psycopg://agro:agro@localhost:5433/agrocopilot
CORS_ORIGINS=http://localhost:3000
CELL_SIZE_M=30

# Copilot — optional. Without a key the app uses the DemoProvider (rules, no cost).
# auto = use the first available key; or force: demo | anthropic | openai
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
